{
  "durationSeconds": 58.06,
  "durationInFrames": 1742,
  "beatTimings": {
    "b1": {
      "startSec": 0.15,
      "endSec": 1.145,
      "startFrame": 4,
      "endFrame": 34,
      "text": "Why does ice float?"
    },
    "b2": {
      "startSec": 1.245,
      "endSec": 6.319,
      "startFrame": 37,
      "endFrame": 190,
      "text": "In this kitchen, Noob drops an ice cube into a glass of water. And it does not sink. It floats."
    },
    "b3": {
      "startSec": 6.399,
      "endSec": 10.939,
      "startFrame": 192,
      "endFrame": 328,
      "text": "That is strange. Ice is solid water. And solid things usually sink to the bottom."
    },
    "b4": {
      "startSec": 11.039,
      "endSec": 16.522,
      "startFrame": 331,
      "endFrame": 496,
      "text": "Here is the secret. When water freezes, it spreads out. It takes up more room than the water it came from."
    },
    "b5": {
      "startSec": 16.622,
      "endSec": 21.65,
      "startFrame": 499,
      "endFrame": 650,
      "text": "So the same water gets bigger, and lighter for its size. Ice is less dense than liquid water."
    },
    "b6": {
      "startSec": 21.75,
      "endSec": 25.16,
      "startFrame": 653,
      "endFrame": 755,
      "text": "Less dense means it floats. Like a beach ball floats on a swimming pool."
    },
    "b7": {
      "startSec": 25.26,
      "endSec": 29.549,
      "startFrame": 758,
      "endFrame": 886,
      "text": "Look closely. Only a little bit of the ice sticks out. Most of it hides under the water."
    },
    "b8": {
      "startSec": 29.649,
      "endSec": 33.73,
      "startFrame": 889,
      "endFrame": 1012,
      "text": "And that floating ice saves lives. In winter, the top of a lake freezes first."
    },
    "b9": {
      "startSec": 33.83,
      "endSec": 37.935,
      "startFrame": 1015,
      "endFrame": 1138,
      "text": "The ice floats and makes a roof over the lake. Underneath, the water stays liquid."
    },
    "b9b": {
      "startSec": 38.035,
      "endSec": 43.134,
      "startFrame": 1141,
      "endFrame": 1294,
      "text": "If ice sank instead, lakes would freeze from the bottom up, and the fish would have nowhere left to swim."
    },
    "b10": {
      "startSec": 43.234,
      "endSec": 47.381,
      "startFrame": 1297,
      "endFrame": 1421,
      "text": "But the ice floats. So the fish keep swimming, safe under the ice, all winter long."
    },
    "b11": {
      "startSec": 47.481,
      "endSec": 52.833,
      "startFrame": 1424,
      "endFrame": 1585,
      "text": "So ice floats because frozen water is lighter for its size. And that is why fish survive the winter."
    },
    "b12": {
      "startSec": 52.933,
      "endSec": 57.36,
      "startFrame": 1588,
      "endFrame": 1721,
      "text": "Next time you hear ice clink in a glass, remember: you are watching water break its own rule."
    }
  },
